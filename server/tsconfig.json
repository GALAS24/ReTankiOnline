{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": [ "../shared/*" ]
    }
  },
  "include": [ "src/**/*", "../shared/**/*" ]
}